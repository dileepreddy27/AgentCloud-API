# Safe local defaults. Replace every production secret in a managed secret store.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://agentcloud:agentcloud@postgres:5432/agentcloud
REDIS_URL=redis://redis:6379/0
API_KEYS=dev-client:change-me-before-production
LLM_PROVIDER=mock
LLM_MODEL=mock-v1
LLM_API_KEY=
LLM_BASE_URL=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
WORKER_MAX_RETRIES=3
WORKER_RETRY_BASE_SECONDS=1
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO

